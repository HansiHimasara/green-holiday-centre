# Copy to .env. Never commit .env or real secrets.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres"
APP_BASE_URL="http://localhost:3000"
# Generate each secret with: openssl rand -hex 32
BOOKING_LINK_SECRET=""
CRON_SECRET=""

# Pricing: vehicle rates and driver batta are configured in Admin > Vehicles.
# All services share the same formula (fixed 80 km + map km + 20 km/day + batta).
# USD amounts are rounded UP to the next $5.
# Get a FREE API key from https://www.exchangerate-api.com/ (server-side only).
EXCHANGE_RATE_API_KEY=""
# Optional manual fallback if the API is unavailable; set an agreed 1 USD = X LKR.
# If no API key is set, this manual value becomes the primary rate.
LKR_PER_USD=""
OPENROUTESERVICE_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# One-time setup for npm run admin:create; remove the password after use.
BOOTSTRAP_SUPER_ADMIN_NAME=""
BOOTSTRAP_SUPER_ADMIN_USERNAME=""
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""

# Set true ONLY if the last trusted reverse proxy strips/replaces X-Forwarded-For.
# Otherwise no trustworthy IP address exists: add gateway/WAF rate limiting.
# In-memory counters are not shared across horizontally scaled Node instances.
TRUST_PROXY="false"
