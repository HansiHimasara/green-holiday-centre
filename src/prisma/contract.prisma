// use prisma-8

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  @@type("pg/text@1")

  ADMIN       = "ADMIN"
  SUPER_ADMIN = "SUPER_ADMIN"
}

enum UserStatus {
  @@type("pg/text@1")

  ACTIVE   = "ACTIVE"
  DISABLED = "DISABLED"
}

enum VehicleStatus {
  @@type("pg/text@1")

  ACTIVE   = "ACTIVE"
  INACTIVE = "INACTIVE"
}

enum ServiceType {
  @@type("pg/text@1")

  AIRPORT_TRANSFER = "AIRPORT_TRANSFER"
  DAY_TOUR         = "DAY_TOUR"
  ROUND_TOUR       = "ROUND_TOUR"
}

enum BookingStatus {
  @@type("pg/text@1")

  PENDING   = "PENDING"
  CONFIRMED = "CONFIRMED"
  CANCELLED = "CANCELLED"
  COMPLETED = "COMPLETED"
}

enum PaymentStatus {
  @@type("pg/text@1")

  UNPAID   = "UNPAID"
  PENDING  = "PENDING"
  PAID     = "PAID"
  FAILED   = "FAILED"
  REFUNDED = "REFUNDED"
}

enum FeedbackVisibility {
  @@type("pg/text@1")

  VISIBLE = "VISIBLE"
  HIDDEN  = "HIDDEN"
}

enum ContactStatus {
  @@type("pg/text@1")

  NEW     = "NEW"
  READ    = "READ"
  REPLIED = "REPLIED"
}


// ======================================================
// ADMIN / SUPER ADMIN
// Customer login ekak naha
// ======================================================

model User {
  id              Int        @id @default(autoincrement())

  fullName        String
  username        String?    @unique
  email           String     @unique
  passwordHash    String
  phone           String?

  role            UserRole   @default(ADMIN)
  status          UserStatus @default(ACTIVE)

  profileImageUrl String?
  lastLoginAt     TimestamptzString?

  sessions        Session[]
  resetTokens     PasswordResetToken[]

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}


// ======================================================
// LOGIN SESSION
// Browser cookie token eke hash eka witharai DB eke thiyenne
// ======================================================

model Session {
  id        Int    @id @default(autoincrement())
  userId    Int

  tokenHash String @unique
  expiresAt TimestamptzString

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
}


// ======================================================
// FORGOT PASSWORD
// ======================================================

model PasswordResetToken {
  id        Int    @id @default(autoincrement())
  userId    Int

  tokenHash String @unique
  expiresAt TimestamptzString
  usedAt    TimestamptzString?

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt TimestamptzString @default(now())
}


// ======================================================
// CUSTOMERS
// Customer account/login ekak naha
// ======================================================

model Customer {
  id                  Int    @id @default(autoincrement())

  fullName            String
  email               String @unique
  phone               String

  passportNumber      String?
  nationality         String?
  address             String?
  specialRequirements String?

  bookings            Booking[]
  feedbacks           Feedback[]

  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}


// ======================================================
// VEHICLE TYPES
//
// Me project eke actual individual vehicles stock track
// karanne naha. Vehicle class/type witharai.
// ======================================================

model VehicleType {
  id                  Int           @id @default(autoincrement())

  name                String        @unique
  description         String?

  passengerCapacity   Int
  luggageCapacity     Int

  transmission        String?
  fuelType            String?
  airConditioning     Boolean       @default(true)
  chauffeurIncluded   Boolean       @default(true)
  chauffeurLanguage   String?

  imageUrl            String?

  status              VehicleStatus @default(ACTIVE)

  bookings            Booking[]

  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}


// ======================================================
// BOOKINGS
//
// AIRPORT_TRANSFER / DAY_TOUR / ROUND_TOUR
// තුනම එකම table එකෙන්.
// ======================================================

model Booking {
  id               Int           @id @default(autoincrement())

  bookingReference String        @unique

  customerId       Int
  vehicleTypeId    Int

  serviceType      ServiceType

  travelDate       DateString
  returnDate       DateString?

  passengerCount   Int
  luggageCount     Int           @default(0)
  numberOfNights   Int?

  pickupLocation   String?
  dropoffLocation  String?
  flightNumber     String?
  specialRequests  String?

  totalAmount      Decimal
  currency         String        @default("USD")

  status           BookingStatus @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)

  customer Customer @relation(
    fields: [customerId],
    references: [id]
  )

  vehicleType VehicleType @relation(
    fields: [vehicleTypeId],
    references: [id]
  )

  destinations BookingDestination[]
  payments     Payment[]
  feedback     Feedback?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


// ======================================================
// ROUND TOUR NIGHT-BY-NIGHT DESTINATIONS
// ======================================================

model BookingDestination {
  id          Int    @id @default(autoincrement())

  bookingId   Int
  nightNumber Int
  destination String

  booking Booking @relation(
    fields: [bookingId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([bookingId, nightNumber])
}


// ======================================================
// PRICING / MILEAGE
//
// Admin "Our Mileages" page ekata.
// ======================================================

model Pricing {
  id                   Int     @id @default(autoincrement())

  fromLocation         String
  toLocation           String

  kilometres           Decimal
  extraKilometreCharge Decimal

  active               Boolean @default(true)

  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()
}


// ======================================================
// PAYMENT
//
// IMPORTANT:
// Card number / expiry / CVV database eke store karanne naha.
// ======================================================

model Payment {
  id                   Int           @id @default(autoincrement())

  bookingId            Int

  transactionReference String?       @unique
  amount               Decimal
  currency             String        @default("USD")

  paymentMethod        String?
  status               PaymentStatus @default(PENDING)
  paidAt               TimestamptzString?

  // Existing DB foreign key behavior eka change nokara thiyenawa.
  // E nisa migration planner issue eka enne naha.
  booking Booking @relation(
    fields: [bookingId],
    references: [id]
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


// ======================================================
// FEEDBACK
//
// Frontend eke Booking Reference "Optional" nisa
// customerId / bookingId optional.
// ======================================================

model Feedback {
  id         Int                @id @default(autoincrement())

  customerId Int?
  bookingId  Int?               @unique

  fullName   String
  email      String?

  rating     Int
  message    String

  visibility FeedbackVisibility @default(VISIBLE)

  customer Customer? @relation(
    fields: [customerId],
    references: [id]
  )

  booking Booking? @relation(
    fields: [bookingId],
    references: [id]
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


// ======================================================
// CONTACT US
// ======================================================

model ContactMessage {
  id        Int           @id @default(autoincrement())

  name      String
  email     String
  phone     String?
  message   String

  status    ContactStatus @default(NEW)

  readAt    TimestamptzString?
  repliedAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}